# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local HTTPS dev certificates (npm run phone). Never commit these.
.certs/

# Version-matched MediaPipe WASM, copied from node_modules by dev/sync-assets.mjs
# (npm postinstall). Regenerable, so not committed.
public/wasm/

# The Face Landmarker model is an *app* asset, not a backend model artifact: it has
# to ship with the frontend so face tracking works offline and never depends on a
# CDN at runtime. The repo-root `models/` pattern would ignore it, so re-include it.
!public/models/
!public/models/**

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
